{
  "name": "botalot",
  "version": "1.1.0",
  "description": "Botalot: a software factory for coding agents. Workflows, step skills and knowledge, the driver that runs them, and a fantasy command view on top.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "botalot": "bin/botalot.mjs"
  },
  "files": [
    "bin",
    "cli",
    "workflows",
    "skills",
    "knowledge",
    "schemas"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node cli/check-brain.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify:cli": "npm run check && npm test",
    "verify:app": "npm --prefix app run verify",
    "verify": "npm run verify:cli && npm run verify:app",
    "app:install": "npm --prefix app install",
    "dev": "npm --prefix app run dev",
    "demo": "npm --prefix app run demo --",
    "dist": "npm --prefix app run dist",
    "hooks": "husky",
    "skills:update": "skills update --project -y",
    "ci:changes": "node scripts/ci/changed-checks.cjs",
    "commits:check": "commitlint --from origin/main --to HEAD --verbose"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "skills": "1.7.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
