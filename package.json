{
  "name": "botalot",
  "version": "0.1.0",
  "description": "Botalot: a fantasy command view where every coding-agent session is a dragon in your kingdom",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo": "electron-vite build && node scripts/demo/demo.cjs",
    "skills:check": "node scripts/skills/check.cjs",
    "skills:update": "skills update --project -y && node scripts/skills/check.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-vite": "^6.0.0",
    "skills": "1.7.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
